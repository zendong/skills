    "completionMode": "one_tap",
    "contentMode": "follow_along",
    "followPlan": {
      "afterCompletionPolicy": "continue_last_level",
      "levels": [
        {
          "title": "短桥",
          "description": "用臀桥建立髋伸和后链发力。",
          "targetSessions": 6,
          "promotionCriterion": "能完成3组，每组30-50次，腰背无不适。",
          "estMinutes": 8,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "仰卧屈膝，双脚踩地与髋同宽。收紧臀部，把髋部抬起到肩、髋、膝接近一条线，再慢慢放下。动作重点在臀腿发力，不要用腰部猛顶。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/5aeLoh2qPLckksD2Wf8f7B/content/d0e55490c28a6cee45e57b61f40468c538ce6026fc86df63be6d310fb456293a.jpg",
              "caption": "臀部发力，髋部抬起；注意不用腰部猛顶。"
            }
          ]
        },
        {
          "title": "直桥",
          "description": "增加肩部支撑和身体后侧张力。",
          "targetSessions": 6,
          "promotionCriterion": "能完成3组，每组30-40次，肩部稳定无痛。",
          "estMinutes": 8,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "坐姿双腿伸直，双手放在身体后方撑地。向上推起髋部，让身体从肩到脚跟接近直线，再慢慢回到坐姿。胸口保持打开，肩膀不要耸到耳边。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/5aeLoh2qPLckksD2Wf8f7B/content/889284aaad8970d138442142b62594d1ac8e5b8969d51bb8785a936849cb48f3.jpg",
              "caption": "胸口打开，肩不耸；注意身体成线。"
            }
          ]
        },
        {
          "title": "高台桥",
          "description": "通过高台降低完整桥的难度。",
          "targetSessions": 7,
          "promotionCriterion": "能完成3组，每组20-30次，肩胸打开可控。",
          "estMinutes": 10,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "让上背靠在不会滑动的稳固软台或床沿，双脚踩稳。手脚协调发力，温和打开胸腔与髋部，再慢慢回落。颈部保持舒适，支撑面必须防滑。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/5aeLoh2qPLckksD2Wf8f7B/content/da0aa7587ee38b14d211db75c9ecf1e29b84987ca1c1dc1667a597bd836543c9.jpg",
              "caption": "高台支撑，打开髋胸；注意支撑防滑、颈部舒适。"
            }
          ]
        },
        {
          "title": "头桥",
          "description": "为完整桥准备更大范围，但头顶只轻触软垫。",
          "targetSessions": 7,
          "promotionCriterion": "能完成2-3组，每组15-20次，双手双脚主承重且颈部无压力。",
          "estMinutes": 10,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "仰卧屈膝，双手平放在耳侧，头下放厚软垫。手脚主动推地，抬起髋胸，让头顶只轻轻接触软垫，绝不把体重压在颈部。头颈出现任何不适都立即退回上一练阶。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/5aeLoh2qPLckksD2Wf8f7B/content/55b49d963bc6e29d1fad7873665c6f800f85dfff0919a6475578a78b3c2250fa.jpg",
              "caption": "手脚主承重，头顶只轻触软垫；注意绝不压颈。"
            }
          ]
        },
        {
          "title": "半桥",
          "description": "进入接近完整桥的低幅轮式支撑。",
          "targetSessions": 8,
          "promotionCriterion": "能完成2-3组，每组15-20次，头肩离垫且手脚支撑稳定。",
          "estMinutes": 12,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "仰卧屈膝，双手放在耳侧。手脚同时推地，让头、肩、上背和髋部离开垫面，进入低幅度轮式；手肘与膝盖保留弯曲，不追求完整桥高度。保持呼吸并慢慢回落。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/5aeLoh2qPLckksD2Wf8f7B/content/e791055640418f8186d83e8f731b4cb7c2a907939257ec6c65edaea3d71538f8.jpg",
              "caption": "双手耳侧，头肩离垫，只做低幅轮式；注意不追极限。"
            }
          ]
        },
        {
          "title": "标准桥",
          "description": "完成地面完整桥，建立桥式基础。",
          "targetSessions": 8,
          "promotionCriterion": "能完成2组，每组10-15次或稳定保持20-30秒。",
          "estMinutes": 12,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "从仰卧屈膝开始，双手放在耳侧，手脚同时推地进入完整桥。让头部离地，胸口打开，髋部抬高。下降时先弯手肘和膝盖，再慢慢回到垫面。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/5aeLoh2qPLckksD2Wf8f7B/content/9c6f747c0497bce09fdd355ffc66aee402bf277f2e2e70f89358c713fdb366fa.jpg",
              "caption": "手臂推地，髋部抬高；注意头部离垫、慢慢下降。"
            }
          ]
        },
        {
          "title": "靠墙下桥",
          "description": "从站立开始，借墙训练向后下桥。",
          "targetSessions": 9,
          "promotionCriterion": "能在保护下完成2组，每组5-8次，下行全程可控。",
          "estMinutes": 14,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "背对清晰稳固墙面站立，双脚离墙一小步。双手向后找到墙面，沿墙一步步向下移动，只到个人可控深度。保持呼吸；一旦失控就在当前高度停住，并在伙伴协助下返回。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/5aeLoh2qPLckksD2Wf8f7B/content/9581b985f909a0809d51f3c224d3c4e7bf145dadd773d3d39fd54a0d6fb0ada8.jpg",
              "caption": "双手找墙，一步步下；注意失控即停并寻求保护。"
            }
          ]
        },
        {
          "title": "靠墙起桥",
          "description": "借墙从低位回到站立，训练反向控制。",
          "targetSessions": 10,
          "promotionCriterion": "能在保护下完成2组，每组5-8次，上行稳定不慌乱。",
          "estMinutes": 15,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "从靠墙较低位置开始，双手沿墙一步步向上走，脚下保持稳定，直到站直。让手、肩、髋协调发力，不要急着用腰部猛推。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/5aeLoh2qPLckksD2Wf8f7B/content/384cb58fea482e917861d2f97041483f2d765e07c0acae76bd4f2747cbf85c70.jpg",
              "caption": "沿墙向上，脚下稳定；注意别急着推腰。"
            }
          ]
        },
        {
          "title": "站立下桥",
          "description": "不借墙从站立向后下到桥，属于高风险练阶。",
          "targetSessions": 10,
          "promotionCriterion": "在伙伴保护下完成2组，每组3-5次，落地安静稳定。",
          "estMinutes": 15,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "只在标准桥和墙面下桥稳定后尝试。站在厚垫上，伙伴在旁保护，双脚稳固、双手向上后方伸，髋部向前、胸口打开，缓慢向后找到地面。没有保护或失去控制能力时不要尝试。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/5aeLoh2qPLckksD2Wf8f7B/content/2fadf0f9baa7f3924890d37cf5e81d7a28958570951ba11b2c6b71c1d4f25b5c.jpg",
              "caption": "胸口打开，安静落地；注意软垫与伙伴保护不可省略。"
            }
          ]
        },
        {
          "title": "站立下桥再起身",
          "description": "桥式路线的极高阶目标，质量和安全优先。",
          "targetSessions": 12,
          "promotionCriterion": "能在保护下完成1-2组，每组1-3次完整往返，并保持安全退出。",
          "estMinutes": 16,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "只适合长期训练者在充分热身、厚垫和伙伴保护下尝试。从站立进入下桥，稳定桥形后，再由腿、臀、背和肩协同回到站立。任何疼痛、眩晕或失控都立即结束，绝不追求次数。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/5aeLoh2qPLckksD2Wf8f7B/content/912cce655b7864eb644065f4a9a4a0ad559a79219ad544603a21a01fcab46c07.jpg",
              "caption": "下桥再起，质量优先；注意充分热身、厚垫和伙伴保护。"
            }
          ]
        }
      ],
