  "template": {
    "title": "从墙推到标准俯卧撑",
    "description": "用六个可重复练阶，从墙壁俯卧撑逐步建立到标准俯卧撑所需的推力和身体控制；动作稳定、无疼痛并保留余力后再进阶。",
    "iconCode": "fitness",
    "colorCode": "blue",
    "scheduleType": "weekly_quota",
    "scheduleConfigJson": "{\"quota\":3}",
    "timezone": "Asia/Shanghai",
    "deadlineLocalTime": "20:00",
    "gracePolicy": "none",
    "completionMode": "one_tap",
    "contentMode": "follow_along",
    "followPlan": {
      "afterCompletionPolicy": "continue_last_level",
      "levels": [
        {
          "title": "墙壁俯卧撑",
          "description": "用较小负荷学习全身成线和肩胛稳定。",
          "targetSessions": 4,
          "estMinutes": 8,
          "promotionCriterion": "能以稳定节奏完成3组，每组15—20次，全程无疼痛并保留2—3次余力。",
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "面对稳固墙面站立，双脚与髋同宽，双手扶墙略宽于肩并与胸同高。收紧腹部，让头、躯干和腿保持一条直线；吸气屈肘让胸口靠近墙面，呼气缓慢推回。手肘约向后下方移动，不耸肩、不塌腰。每次做2—3组，每组8—20次，以动作质量为先。"
            },
            {
              "blockType": "image",
              "assetId": "wall",
              "caption": "身体成线靠近墙面；不要塌腰或耸肩。",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/material/100000/action-assets/staging/content/20260811T091513Z-b813a6d451-wall.jpg"
            }
          ]
        },
        {
          "title": "高位斜板俯卧撑",
          "description": "降低支撑高度，增加上肢和核心负荷。",
          "targetSessions": 5,
          "estMinutes": 10,
          "promotionCriterion": "能在稳固高台完成3组，每组12—18次，下降和推起都可控。",
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "双手撑在不会滑动的高桌、栏杆或固定台面上，双脚后退到身体成直线。肩膀保持远离耳朵，胸口朝支撑面下降，再用胸、臂和躯干一起推回。先检查支撑物稳定，不使用带轮椅子或容易倾倒的家具。"
            },
            {
              "blockType": "image",
              "assetId": "incline",
              "caption": "选择稳固高台，身体从头到脚保持直线。",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/material/100000/action-assets/staging/content/20260811T091515Z-35a93d9b3c-incline.jpg"
            }
          ]
        },
        {
          "title": "低位斜板俯卧撑",
          "description": "进一步降低支撑面，为地面动作建立力量。",
          "targetSessions": 5,
          "estMinutes": 10,
          "promotionCriterion": "能在较低稳固台面完成3组，每组10—15次，底部停顿后仍可控制推起。",
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "把支撑面降到稳固长凳或固定矮台。双手略宽于肩，臀部不过度抬高，胸口沿双手之间下降；底部短暂停顿，再平稳推回。若腰部开始塌陷或肩部不适，立即减少次数或回到更高支撑。"
            },
            {
              "blockType": "image",
              "assetId": "incline",
              "caption": "支撑面越低负荷越大；始终优先保证台面稳定。",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/material/100000/action-assets/staging/content/20260811T091515Z-35a93d9b3c-incline.jpg"
            }
          ]
        },
        {
          "title": "跪姿俯卧撑",
          "description": "进入地面推力训练，同时保留可控负荷。",
          "targetSessions": 6,
          "estMinutes": 10,
          "promotionCriterion": "能完成3组，每组10—15次，头到膝盖成线且髋部不后坐。",
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "双膝着垫，双手略宽于肩，身体从头到膝盖保持直线。吸气下降到胸口接近地面，呼气推起。臀部不要留在后方，腰部不要下沉；膝盖不适时加厚软垫。"
            },
            {
              "blockType": "image",
              "assetId": "kneeling",
              "caption": "头、髋、膝保持一线，不要把动作做成跪趴。",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/material/100000/action-assets/staging/content/20260811T091517Z-d4a274d5be-kneeling.jpg"
            }
          ]
        },
        {
          "title": "标准姿势慢速下放",
          "description": "用离心阶段学习标准俯卧撑的完整身体控制。",
          "targetSessions": 6,
          "estMinutes": 12,
          "promotionCriterion": "能完成3组，每组5—8次，每次用3—5秒下放且身体不塌腰、不旋转。",
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "从标准支撑位开始，主动收紧臀腹，用3—5秒缓慢下降到胸口接近地面；双膝落地后回到起点，不必勉强从底部推起。每组只保留动作稳定的次数。手腕不适时可使用稳固俯卧撑支架或回到斜板练阶。"
            },
            {
              "blockType": "image",
              "assetId": "half",
              "caption": "慢速下放时全身一起移动，不用腰部抢动作。",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/material/100000/action-assets/staging/content/20260811T091518Z-6d8bf57521-half.jpg"
            }
          ]
        },
        {
          "title": "标准俯卧撑",
          "description": "完成路线目标，并以少量高质量次数继续巩固。",
          "targetSessions": 8,
          "estMinutes": 12,
          "promotionCriterion": "能完成3组，每组8—12次，动作范围完整、节奏可控且无疼痛。",
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "双手略宽于肩，脚尖着地，身体保持直线。吸气用约2秒下降，胸口接近地面后呼气推起；手肘不要完全向两侧张开。每组结束时应还能保留2—3次余力。出现肩、肘、腕疼痛、眩晕或异常不适时立即停止；既往伤病、孕期或特殊健康情况请先咨询合格专业人士。"
            },
            {
              "blockType": "image",
              "assetId": "standard",
              "caption": "标准俯卧撑以完整动作和稳定身体线为先。",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/material/100000/action-assets/staging/content/20260811T091521Z-fda92b1430-standard.jpg"
            }
          ]
        }
      ],
      "checkpoints": [
        {
          "levelIndex": 2,
          "title": "斜板阶段达标",
          "description": "能够在低位稳固支撑上保持全身成线和可控节奏。",
          "isKey": false
        },
        {
          "levelIndex": 4,
          "title": "标准姿势可控",
          "description": "能够以标准支撑姿势慢速下放，为完整推起做好准备。",
          "isKey": true
        },
        {
          "levelIndex": 5,
          "title": "完成标准俯卧撑",
          "description": "以无痛、稳定、保留余力的方式完成标准俯卧撑。",
          "isKey": true
        }
      ]
    }
  },
