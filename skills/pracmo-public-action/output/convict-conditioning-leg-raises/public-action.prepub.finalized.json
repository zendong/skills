          "isKey": true
        },
        {
          "levelIndex": 6,
          "title": "悬垂核心稳定",
          "description": "悬垂屈腿举稳定，握力、肩部和长杠杆控制可承接下一阶段。",
          "isKey": false
        },
        {
          "levelIndex": 9,
          "title": "举腿十式通关",
          "description": "能完成可控的悬垂直腿举，保留最后练阶继续巩固。",
          "isKey": true
        }
      ]
    }
  },
