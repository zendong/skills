          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "靠墙倒立，一手撑地为主力，另一手撑在不会滑动的低支撑物上。下降和推起时保持身体尽量不旋转。左右交替，小范围高质量优先。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/6TqCeUlBokClwC2dgba4sG/content/f0c18834a910ebbcec94763b99ad96d4615bfddf9d699ecac07d36beb9da2492.jpg",
              "caption": "主手撑地，辅手低台；注意支撑稳固、身体少转。"
            }
          ]
        },
        {
          "title": "半程单臂倒立撑",
          "description": "单臂路线的高难准备，只做很小范围。",
