      "levels": [
        {
          "title": "靠墙头倒立",
          "description": "熟悉倒置姿势，但不把重量压到颈部。",
          "targetSessions": 6,
          "promotionCriterion": "能稳定保持3组，每组30-60秒，肩部主动且颈部无压力。",
          "estMinutes": 8,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "在厚软垫和墙边练习，双手与头部形成稳定三角，轻轻把脚靠到墙上。肩膀主动发力，让双手承担主要重量，头顶只轻触垫面。眩晕、眼部不适或颈部压力出现时立即退出。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/6TqCeUlBokClwC2dgba4sG/content/cb18f9817d105b89af9b578f94e045ec4ca64d395cab423b6391e8225d262681.jpg",
              "caption": "三角支撑，肩主动推；注意颈部不承重。"
            }
          ]
        },
        {
          "title": "乌鸦式",
          "description": "建立手腕承重、肩胛前推和身体平衡。",
          "targetSessions": 6,
          "promotionCriterion": "能稳定保持3组，每组30-60秒，并可安全落脚。",
          "estMinutes": 8,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "双手撑在厚垫上，膝盖靠近上臂，重心慢慢向前。脚尖轻离地后保持平衡，眼睛看前下方。手指抓地、肩背主动撑开，前方留出足够软垫空间。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/6TqCeUlBokClwC2dgba4sG/content/8511c2c71641d458a2c5718ec9ec01ce91c776fc6836e949372085f3d9e63af1.jpg",
              "caption": "手指抓地，肩背撑开；注意前方留垫、别向前栽。"
            }
          ]
        },
        {
          "title": "靠墙倒立",
          "description": "建立完整倒立支撑能力。",
          "targetSessions": 7,
          "promotionCriterion": "能稳定保持3组，每组60秒，肩膀主动且能安全退出。",
          "estMinutes": 10,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "在厚垫和伙伴保护下进入靠墙倒立，双手扎稳，双脚轻靠墙。手臂伸直但不锁死，肩膀主动上推，肋骨回收。保持呼吸，退出时一脚一脚安全落地。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/6TqCeUlBokClwC2dgba4sG/content/7be3a4b6f8dfcd3582f92b46f45cc3652b2dab76bf1dc05ab24742ef0b435a5d.jpg",
              "caption": "手臂伸直，脚轻靠墙；注意肩膀不塌并能安全退出。"
            }
          ]
        },
        {
          "title": "半程倒立撑",
          "description": "在靠墙倒立中训练小幅、可控推力。",
          "targetSessions": 7,
          "promotionCriterion": "能完成2-3组，每组8-10次，下降幅度一致且头部远离垫面。",
          "estMinutes": 12,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "靠墙倒立后，缓慢弯曲手肘，只下降小幅度，头部与厚垫保持明显距离，再推回伸直。肩膀持续主动，每次都控制下降，不使用反弹。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/6TqCeUlBokClwC2dgba4sG/content/0a63bf299f671628e172f61d0c38e07ebfa2ac1b694b2619c72e343853fcd2f3.jpg",
              "caption": "直臂起始，只做浅幅下降；注意头部远离垫面、不反弹。"
            }
          ]
        },
        {
          "title": "标准倒立撑",
          "description": "完成靠墙完整倒立撑。",
          "targetSessions": 8,
          "promotionCriterion": "能完成2组，每组5-8次，底部可控且能安全退出。",
          "estMinutes": 12,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "靠墙倒立，弯肘下降到头部接近厚软垫或个人可控深度，再平稳推回顶端。保持身体紧张，不塌腰。底部失控时立即退出并退回半程倒立撑。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/6TqCeUlBokClwC2dgba4sG/content/18eec5d26b06c85273ddc7769cebfea32db08b20cf7573ac26b6146e1ae1a38c.jpg",
              "caption": "直臂起始，头近软垫；注意底部可控。"
            }
          ]
        },
        {
          "title": "窄距倒立撑",
          "description": "缩小手距，提高肩臂推力要求。",
          "targetSessions": 8,
          "promotionCriterion": "能完成2组，每组5-8次，手腕和肩部无不适。",
          "estMinutes": 12,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "靠墙倒立后，把双手间距缩小到仍能保持肩腕舒适的位置。慢慢下降并推起，肘部轨迹保持可控。肩部夹挤或手腕疼痛时立即放宽手距或退阶。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/6TqCeUlBokClwC2dgba4sG/content/18fecbbef6605cf4d60d87d7224723574daec175d00d64b72dd9a9b7fb92f473.jpg",
              "caption": "双手收窄，肘路可控；注意肩腕无痛。"
            }
          ]
        },
        {
          "title": "偏重倒立撑",
          "description": "一手主力，一手在稳固低台上辅助。",
          "targetSessions": 9,
          "promotionCriterion": "左右两侧都能完成2组，每组3-5次，身体旋转受控。",
