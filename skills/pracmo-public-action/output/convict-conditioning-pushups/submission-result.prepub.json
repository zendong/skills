    "followPlan": {
      "afterCompletionPolicy": "continue_last_level",
      "levels": [
        {
          "title": "墙壁俯卧撑",
          "description": "用最小负荷熟悉推起和身体成一直线的感觉。",
          "targetSessions": 6,
          "promotionCriterion": "能稳定完成3组，每组40-50次，动作全程可控。",
          "estMinutes": 8,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "面对墙站立，双脚并拢或与髋同宽，双手扶墙与胸同高。吸气弯曲手肘，让额头或胸口方向靠近墙面；呼气推回。保持身体成一条直线，不塌腰、不耸肩。完成2-3组，每组留2-3次余力。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/2Bxxup84KJhwBheTu38ayS/content/2a56875929ac5db56d8a17c0beb2e04c11058fa0cbec8cdf7de7f57d1689e314.jpg",
              "caption": "身体一线，慢下稳推；注意不塌腰、不耸肩。"
            }
          ]
        },
        {
          "title": "上斜俯卧撑",
          "description": "把支点从墙面降低到桌沿、栏杆或稳固台面。",
          "targetSessions": 6,
          "promotionCriterion": "能稳定完成3组，每组30-40次。",
          "estMinutes": 10,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "双手撑在稳固高台上，脚向后退，身体从头到脚保持直线。缓慢下降到胸口接近支撑面，再推回起点。选择不会滑动的支撑物，动作中肩胛保持稳定，腰腹持续收紧。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/2Bxxup84KJhwBheTu38ayS/content/f500790ffbf976086184a499c5105abdaadd017927fade2147772deb58cd2ca9.jpg",
              "caption": "撑稳桌边，身体成线；注意桌椅稳固、不塌腰。"
            }
          ]
        },
        {
          "title": "跪姿俯卧撑",
          "description": "进入地面推力训练，同时降低完整俯卧撑负荷。",
          "targetSessions": 7,
          "promotionCriterion": "能完成3组，每组25-30次，髋部不后坐。",
          "estMinutes": 10,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "双膝着地，双手略宽于肩，身体从头到膝盖保持直线。下降时胸口靠近地面，底部停顿一瞬再推起。不要把臀部留在后方，也不要用腰部塌陷换次数。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/2Bxxup84KJhwBheTu38ayS/content/659acc924377cd77c3ae330da7d2ec7507b0f7b3c89cbd2eca7fff74b0b1eeb9.jpg",
              "caption": "头膝一线，胸口下沉；注意髋不后坐、肩不耸。"
            }
          ]
        },
        {
          "title": "半程俯卧撑",
          "description": "以完整支撑姿势训练上半程控制。",
          "targetSessions": 7,
          "promotionCriterion": "能完成2-3组，每组20-25次，半程深度一致。",
          "estMinutes": 12,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "进入标准俯卧撑支撑位，在胸下放一个安全高度的参照物。下降到约半程后停住，再推回顶端。保持腿、髋、躯干同时移动，不让肩膀单独前冲。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/2Bxxup84KJhwBheTu38ayS/content/f30cbe8e1491abc8632a80e3172e78e8fca5a4e4c0ebcbd86953458650a925aa.jpg",
              "caption": "半程一致，核心收紧；注意不用弹震、不塌腰。"
            }
          ]
        },
        {
          "title": "标准俯卧撑",
          "description": "建立完整俯卧撑的基础力量和节奏。",
          "targetSessions": 8,
          "promotionCriterion": "能完成2-3组，每组15-20次，底部停顿不借力。",
          "estMinutes": 12,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "双手撑地略宽于肩，脚尖着地，身体保持直线。用2秒下降、底部短暂停顿、2秒推起的节奏练习。每次到底部都保持胸、肩、肘可控，不用弹震抢次数。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/2Bxxup84KJhwBheTu38ayS/content/4e010a49a6482dbbf89aeb2b462d7b91690520149ee95bceefaeef5c9704f30d.jpg",
              "caption": "全身成线，胸口靠近；注意不塌腰、不抢速。"
            }
          ]
        },
        {
          "title": "窄距俯卧撑",
          "description": "缩小手距，提高肱三头肌、胸肩稳定和躯干控制要求。",
          "targetSessions": 8,
          "promotionCriterion": "能完成2组，每组15-20次，肘腕无不适。",
          "estMinutes": 12,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "双手放在胸下方，手距比标准俯卧撑更窄。下降时手肘贴近身体两侧，推起时保持肩膀下沉。若手腕压力明显，先略微放宽手距，确保动作稳定再继续推进。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/2Bxxup84KJhwBheTu38ayS/content/fe07b92490c474e1c6f311496c677a4c8813b775d74a8427c435dfe1f17aa7e2.jpg",
              "caption": "手距收窄，肘贴身体；手腕不适时先放宽手距。"
            }
          ]
        },
        {
          "title": "偏重俯卧撑",
          "description": "一侧手放在球、砖或低支撑物上，让另一侧承担更多负荷。",
          "targetSessions": 9,
          "promotionCriterion": "左右两侧都能完成2组，每组12-15次。",
          "estMinutes": 14,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "一只手撑地，另一只手放在稳固的低支撑物上。下降时身体仍保持正对地面，主要用撑地侧发力推起。左右交替训练，避免身体旋转或把重量全部压到肩关节。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/2Bxxup84KJhwBheTu38ayS/content/8d1f99b86c04932ae562fe4ec27c953d95b99669933d8bc1c8d8f76c88db49bb.jpg",
              "caption": "一侧主力，身体不旋；左右都练，辅助侧不抢力。"
            }
          ]
        },
        {
          "title": "半程单臂俯卧撑",
          "description": "进入单臂支撑模式，先控制半程范围。",
          "targetSessions": 10,
          "promotionCriterion": "左右两侧都能完成2组，每组8-10次。",
          "estMinutes": 15,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "双脚分开增加稳定，一手背在身后，另一手撑地。只下降到半程，保持骨盆尽量水平，再推回顶端。把注意力放在肩、髋、腹同时锁住，宁可少做也不要扭身借力。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/2Bxxup84KJhwBheTu38ayS/content/207b22f83d789a7d700b53163fb2b680b13cd98b8bad9f67d1048494b6f4d6f2.jpg",
              "caption": "单手支撑，只做半程；注意骨盆别转、不要硬撑。"
            }
          ]
        },
        {
          "title": "杠杆俯卧撑",
          "description": "辅助手臂伸远，只提供平衡，主力侧接近单臂发力。",
          "targetSessions": 10,
          "promotionCriterion": "左右两侧都能完成2组，每组8-10次，辅助侧不抢力。",
          "estMinutes": 15,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "一手撑在胸下作为主力，另一手向侧方伸远，指尖或掌根轻触地面辅助平衡。下降和推起都由主力侧完成，辅助侧只防止身体旋转。左右各练，动作全程慢而稳。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/2Bxxup84KJhwBheTu38ayS/content/197aa6282e041aca15be35e7a322d03e71949c5abccc21e1b8df97c65223cc15.jpg",
              "caption": "主手发力，辅手伸远；辅助手只负责稳定平衡。"
            }
          ]
        },
        {
          "title": "单臂俯卧撑",
          "description": "俯卧撑路线的主目标，考验单侧推力和全身抗旋转能力。",
          "targetSessions": 12,
          "promotionCriterion": "左右两侧都能完成2组，每组5-10次，动作范围完整。",
          "estMinutes": 16,
          "contentBlocks": [
            {
              "blockType": "text",
              "textContent": "双脚分开，单手撑在胸下略外侧，另一手背在身后。吸气缓慢下降，保持肩、髋尽量朝向地面；呼气推起。每次只做高质量次数，身体扭转或塌腰时立刻停止本组。"
            },
            {
              "blockType": "image",
              "mediaUrl": "https://wancai-beijing.oss-cn-beijing.aliyuncs.com/public-action/2Bxxup84KJhwBheTu38ayS/content/bcedecfa89cfa3f8b1d2b33d19c963de38a25b3cf03cdc0e555b14736a3a4859.jpg",
              "caption": "单臂主推，全身抗旋；少量高质量，不扭身。"
            }
          ]
        }
      ],
