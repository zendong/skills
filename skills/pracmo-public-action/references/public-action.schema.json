{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.zendong.com.cn/schemas/pracmo-public-action-v2.json",
  "title": "Pracmo Public Action Submission v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "clientRequestId", "catalog", "template", "assets"],
  "properties": {
    "schemaVersion": { "const": "pracmo-public-action@v2" },
    "clientRequestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$" },
    "catalog": { "$ref": "#/$defs/catalog" },
    "template": { "$ref": "#/$defs/template" },
    "assets": { "type": "array", "minItems": 1, "maxItems": 41, "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "tags", "coverImage"],
      "properties": {
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "tags": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
        "coverImage": { "$ref": "#/$defs/imageRef" }
      }
    },
    "template": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description", "iconCode", "colorCode", "scheduleType", "scheduleConfigJson", "timezone", "deadlineLocalTime", "gracePolicy", "completionMode", "contentMode"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "iconCode": { "type": "string", "minLength": 1, "maxLength": 32 },
        "colorCode": { "type": "string", "minLength": 1, "maxLength": 32 },
        "scheduleType": { "enum": ["daily", "weekdays", "weekly_quota", "once"] },
        "scheduleConfigJson": { "type": "string", "maxLength": 1024 },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
        "deadlineLocalTime": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
        "gracePolicy": { "enum": ["none", "two_hours", "next_day_noon"] },
        "completionMode": { "enum": ["one_tap", "text", "rich_media"] },
        "contentMode": { "enum": ["self_directed", "puki_generated", "follow_along"] },
        "generatedContentConfig": { "$ref": "#/$defs/generatedContentConfig" },
        "followPlan": { "$ref": "#/$defs/followPlan" }
      },
      "oneOf": [
        { "properties": { "contentMode": { "const": "self_directed" } }, "not": { "anyOf": [{ "required": ["generatedContentConfig"] }, { "required": ["followPlan"] }] } },
        { "required": ["generatedContentConfig"], "properties": { "contentMode": { "const": "puki_generated" }, "completionMode": { "const": "one_tap" } }, "not": { "required": ["followPlan"] } },
        { "required": ["followPlan"], "properties": { "contentMode": { "const": "follow_along" }, "completionMode": { "const": "one_tap" } }, "not": { "required": ["generatedContentConfig"] } }
      ]
    },
    "generatedContentConfig": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "type", "instruction"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "type": { "enum": ["reading", "quick_qa"] },
        "instruction": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "quickQa": { "$ref": "#/$defs/quickQa" }
      },
      "oneOf": [
        { "properties": { "type": { "const": "reading" } }, "not": { "required": ["quickQa"] } },
        { "required": ["quickQa"], "properties": { "type": { "const": "quick_qa" } } }
      ]
    },
    "quickQa": {
      "type": "object", "additionalProperties": false, "required": ["questionType"],
      "properties": { "questionType": { "enum": ["auto", "single_choice", "multiple_choice", "true_false", "short_answer", "mixed"] } }
    },
    "imageRef": {
      "type": "object", "additionalProperties": false, "required": ["alt"],
      "properties": { "localPath": { "type": "string", "minLength": 1 }, "objectKey": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^https://" }, "alt": { "type": "string", "minLength": 1, "maxLength": 120 } },
      "oneOf": [{ "required": ["localPath"] }, { "required": ["objectKey", "url"] }]
    },
    "asset": {
      "type": "object", "additionalProperties": false, "required": ["assetId", "role", "alt"],
      "properties": {
        "assetId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }, "role": { "enum": ["cover", "content"] },
        "localPath": { "type": "string", "minLength": 1 }, "objectKey": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^https://" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 120 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "contentType": { "enum": ["image/png", "image/jpeg", "image/webp"] }, "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 524288 },
        "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }
      },
      "oneOf": [{ "required": ["localPath"] }, { "required": ["objectKey", "url", "sha256", "contentType", "sizeBytes"] }]
    },
    "followPlan": {
      "type": "object", "additionalProperties": false, "required": ["afterCompletionPolicy", "levels", "checkpoints"],
      "properties": {
        "afterCompletionPolicy": { "enum": ["continue_last_level", "end_action"] },
        "levels": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/level" } },
        "checkpoints": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/checkpoint" } }
      }
    },
    "level": {
      "type": "object", "additionalProperties": false, "required": ["title", "contentBlocks"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "maxLength": 500 },
        "targetSessions": { "type": "integer", "minimum": 1, "maximum": 365 }, "promotionCriterion": { "type": "string", "maxLength": 500 },
        "estMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 }, "contentBlocks": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "type": "object", "additionalProperties": false, "required": ["blockType"],
      "properties": { "blockType": { "enum": ["text", "image"] }, "textContent": { "type": "string", "minLength": 1, "maxLength": 10000 }, "assetId": { "type": "string" }, "mediaUrl": { "type": "string", "pattern": "^https://" }, "caption": { "type": "string", "maxLength": 500 }, "durationSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 } }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false, "required": ["levelIndex", "title", "isKey"],
      "properties": { "levelIndex": { "type": "integer", "minimum": 0 }, "title": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "maxLength": 500 }, "isKey": { "type": "boolean" } }
    }
  }
}
