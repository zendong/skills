{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.zendong.com.cn/schemas/pracmo-learning-track-v1.json",
  "title": "Pracmo Learning Track Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "clientRequestId", "track", "path", "exercises", "actions"],
  "properties": {
    "schemaVersion": {"const": "pracmo-learning-track@v1"},
    "clientRequestId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "goalStatement"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 255},
        "description": {"type": "string", "maxLength": 4000},
        "category": {"type": "string", "maxLength": 64},
        "goalStatement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "goalReason": {"type": "string", "maxLength": 4000},
        "targetUserDescription": {"type": "string", "maxLength": 4000},
        "requirements": {"type": "string", "maxLength": 4000},
        "coverImage": {"$ref": "#/$defs/assetReference"}
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentStateKey", "targetStateKey", "states"],
      "properties": {
        "currentStateKey": {"type": "string", "minLength": 1, "maxLength": 64},
        "targetStateKey": {"type": "string", "minLength": 1, "maxLength": 64},
        "states": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/state"}}
      }
    },
    "concepts": {"type": "array", "items": {"$ref": "#/$defs/concept"}},
    "exercises": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/exercise"}},
    "actions": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/action"}},
    "assets": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/asset"}},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "assetReference": {
      "type": "object", "additionalProperties": false,
      "properties": {"assetId": {"type": "string", "minLength": 1, "maxLength": 64}},
      "required": ["assetId"]
    },
    "criterion": {
      "type": "object", "additionalProperties": false, "required": ["criterionId", "description"],
      "properties": {"criterionId": {"type": "string", "minLength": 1, "maxLength": 64}, "description": {"type": "string", "minLength": 1, "maxLength": 1000}}
    },
    "state": {
      "type": "object", "additionalProperties": false, "required": ["stateKey", "title", "description", "criteria"],
      "properties": {
        "stateKey": {"type": "string", "minLength": 1, "maxLength": 64},
        "title": {"type": "string", "minLength": 1, "maxLength": 255},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "criteria": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/criterion"}}
      }
    },
    "concept": {
      "type": "object", "additionalProperties": false, "required": ["conceptKey", "name"],
      "properties": {"conceptKey": {"type": "string", "minLength": 1, "maxLength": 64}, "name": {"type": "string", "minLength": 1, "maxLength": 255}}
    },
    "stateLink": {
      "type": "object", "additionalProperties": false, "required": ["stateKey", "relationRole", "criterionIds"],
      "properties": {
        "stateKey": {"type": "string"},
        "relationRole": {"enum": ["advance", "assess", "reinforce"]},
        "criterionIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "whyNow": {"type": "string", "maxLength": 1000}
      }
    },
    "option": {
      "type": "object", "additionalProperties": false, "required": ["content", "isCorrect"],
      "properties": {"content": {"type": "string", "minLength": 1}, "isCorrect": {"type": "boolean"}, "explanation": {"type": "string"}}
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["questionType", "questionContent", "conceptKey", "testableClaim"],
      "properties": {
        "questionType": {"enum": ["single_choice", "multiple_choice", "true_false", "short_answer"]},
        "questionContent": {"type": "string", "minLength": 1},
        "explanation": {"type": "string"},
        "difficultyScore": {"type": "integer", "minimum": 0, "maximum": 10},
        "bloomLevel": {"type": "integer", "minimum": 1, "maximum": 4},
        "conceptKey": {"type": "string", "minLength": 1},
        "testableClaim": {"type": "string", "minLength": 1},
        "anchorInfo": {"type": "string"},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}}
      }
    },
    "exercise": {
      "type": "object", "additionalProperties": false, "required": ["exerciseKey", "title", "questions"],
      "properties": {
        "exerciseKey": {"type": "string", "minLength": 1, "maxLength": 64},
        "title": {"type": "string", "minLength": 1, "maxLength": 255},
        "userRequest": {"type": "string", "maxLength": 4000},
        "difficultyLevel": {"type": "integer", "minimum": 0, "maximum": 10},
        "allowQuestionTypes": {"type": "array", "items": {"type": "string"}},
        "questions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/question"}},
        "stateLink": {"$ref": "#/$defs/stateLink"}
      }
    },
    "action": {
      "type": "object", "required": ["actionKey", "title", "scheduleType", "timezone", "startDate", "deadlineLocalTime", "gracePolicy", "completionMode", "contentMode"],
      "properties": {
        "actionKey": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"},
        "iconCode": {"type": "string"}, "colorCode": {"type": "string"},
        "scheduleType": {"enum": ["daily", "weekdays", "weekly_quota", "once"]},
        "scheduleConfigJson": {"type": "string"}, "timezone": {"type": "string"},
        "startDate": {"type": "string", "format": "date"}, "endDate": {"type": "string", "format": "date"},
        "deadlineLocalTime": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "gracePolicy": {"enum": ["none", "two_hours", "next_day_noon"]},
        "completionMode": {"enum": ["one_tap", "text", "rich_media"]},
        "reminderConfigJson": {"type": "string"},
        "contentMode": {"enum": ["self_directed", "puki_generated", "follow_along"]},
        "generatedContentConfig": {"type": "object"}, "followPlan": {"type": "object"},
        "stateLink": {"$ref": "#/$defs/stateLink"}, "evidencePlan": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object", "required": ["assetId"],
      "properties": {
        "assetId": {"type": "string"}, "role": {"enum": ["cover", "question", "action_content"]},
        "localPath": {"type": "string"}, "objectKey": {"type": "string"}, "url": {"type": "string", "format": "uri"},
        "alt": {"type": "string"}, "sha256": {"type": "string"}, "contentType": {"enum": ["image/png", "image/jpeg", "image/webp"]},
        "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 524288}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
